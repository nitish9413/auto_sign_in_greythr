# Copy this file to `.env` (same folder as punch.py / the .exe) and fill it in.
# Never commit `.env`.

# ---- Required ----
GREYTHR_USER=your_employee_id
GREYTHR_PASS=your_password

# ---- Portal ----
GREYTHR_LOGIN_URL=https://kanaka-software.greythr.com/uas/portal/auth/login
GREYTHR_DASHBOARD_PATTERN=**/v3/portal/ess/home**

# ---- Teams alerts (optional; leave blank to disable) ----
# Power Automate Workflows / Incoming Webhook URL
TEAMS_WEBHOOK_URL=

# ---- Browser ----
# Leave blank to use Playwright's own bundled Chromium
# (installed via `playwright install chromium`).
# Set only if you want a specific executable, e.g.:
# CHROMIUM_PATH=C:\Users\<you>\AppData\Local\ms-playwright\chromium-1200\chrome-win64\chrome.exe
CHROMIUM_PATH=
HEADLESS=true

# ---- Behaviour ----
STARTUP_DELAY_SECONDS=10
MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=20
NAV_TIMEOUT_MS=45000
ELEMENT_TIMEOUT_MS=15000

# ---- Resilience ----
# Wait up to N seconds for GreytHR to be reachable before starting (0 = don't wait)
NETWORK_WAIT_MAX_SECONDS=300
# If all MAX_ATTEMPTS fail, try again N more times, this many minutes apart (0 = off)
FOLLOWUP_RETRIES=3
FOLLOWUP_INTERVAL_MINUTES=15
# `punch_in.exe --watchdog` alerts if there is no successful punch-in by this time (HH:MM, 24h)
WATCHDOG_DEADLINE=10:30
# Save the login session and reuse it next time (skips the login page)
SESSION_REUSE=true

# ---- Storage ----
# Where logs/ and screenshots/ go. Blank = same folder as the script/.exe.
DATA_DIR=
# Delete screenshot folders older than N days (0 = keep forever)
SCREENSHOT_RETENTION_DAYS=30
